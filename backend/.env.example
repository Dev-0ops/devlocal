DB_URL=jdbc:mysql://localhost:3306/tododb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_db_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TIMEOUT=2s

JWT_SECRET=your_very_long_random_jwt_secret
JWT_EXPIRATION_MS=86400000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password

# Test profile (.env.test) example values
TEST_DB_URL=jdbc:mysql://localhost:3306/tododb_test?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
TEST_DB_USERNAME=root
TEST_DB_PASSWORD=your_test_db_password

TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6379
TEST_REDIS_DB=0
TEST_REDIS_TIMEOUT=2s

TEST_JWT_SECRET=your_test_jwt_secret
TEST_JWT_EXPIRATION_MS=86400000

TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=your_test_admin_password
